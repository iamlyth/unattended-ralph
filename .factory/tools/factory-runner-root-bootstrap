#!/bin/sh
# Minimal root bootstrap.  This file is installed root-owned only after its
# SHA-256 has been compared with the out-of-band trusted installation manifest.
# It verifies the detached source manifest before parsing or extracting bytes.
set -eu
umask 077
fail(){ printf '%s\n' "bootstrap: $*" >&2; exit 1; }
[ "$(/usr/bin/id -u)" = 0 ] || fail 'must run as root'
[ "${1-}" = install ] || fail 'usage: factory-runner-root-bootstrap install --manifest FILE --signature FILE --allowed-signers FILE --archive FILE -- <installer arguments>'
shift
manifest= signature= signers= archive=
while [ "$#" -gt 0 ]; do
 case "$1" in
  --manifest) manifest=$2;shift 2;; --signature) signature=$2;shift 2;;
  --allowed-signers) signers=$2;shift 2;; --archive) archive=$2;shift 2;;
  --) shift;break;; *) fail "unknown bootstrap option: $1";; esac
done
[ -n "$manifest" ] && [ -n "$signature" ] && [ -n "$signers" ] && [ -n "$archive" ] || fail 'missing authentication input'
# Validate every authentication pathname from / before any privileged parser
# opens it. Root-owned, non-writable ancestors make the subsequent open stable.
/usr/bin/python3 -I - "$manifest" "$signature" "$signers" "$archive" <<'PY'
import os,pathlib,stat,sys
for raw in sys.argv[1:]:
 p=pathlib.Path(raw)
 if not p.is_absolute():raise SystemExit('bootstrap: authentication path is not absolute')
 cur=pathlib.Path('/')
 for part in p.parts[1:]:
  cur/=part;i=os.lstat(cur);leaf=cur==p
  if stat.S_ISLNK(i.st_mode) or i.st_uid!=0 or i.st_mode&0o022 or (not leaf and not stat.S_ISDIR(i.st_mode)) or (leaf and (not stat.S_ISREG(i.st_mode) or i.st_nlink!=1)):raise SystemExit('bootstrap: unsafe authentication path '+str(cur))
PY
# The signing identity and bootstrap digest are supplied by the offline install
# manifest, never by the checkout/archive.  ssh-keygen parses the signature;
# the fixed system Python below parses policy and archive structure.
/usr/bin/ssh-keygen -Y verify -f "$signers" -I factory-runner-install -n factory-runner-install -s "$signature" < "$manifest" >/dev/null 2>&1 || fail 'manifest signature rejected'
stage=$(/usr/bin/mktemp -d /var/tmp/factory-runner-bootstrap.XXXXXX)
cleanup(){ /bin/rm -rf -- "$stage"; }
trap cleanup EXIT HUP INT TERM
/usr/bin/python3 -I - "$manifest" "$archive" "$stage/source" <<'PY'
import base64,hashlib,json,os,pathlib,re,stat,sys,tarfile
mp,archive,out=map(pathlib.Path,sys.argv[1:])
def die(s): raise SystemExit('bootstrap: '+s)
def read_protected(p,maximum):
 if not p.is_absolute():die('authentication inputs must be absolute')
 cur=pathlib.Path('/')
 for part in p.parts[1:-1]:
  cur/=part;i=os.lstat(cur)
  if stat.S_ISLNK(i.st_mode) or not stat.S_ISDIR(i.st_mode) or i.st_uid!=0 or i.st_mode&0o022:die(f'unsafe input ancestor: {cur}')
 before=os.lstat(p);fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW|os.O_CLOEXEC);i=os.fstat(fd)
 try:
  if not stat.S_ISREG(i.st_mode) or i.st_uid!=0 or i.st_mode&0o022 or i.st_nlink!=1:die(f'unsafe input: {p}')
  chunks=[];n=0
  while True:
   b=os.read(fd,65536)
   if not b:break
   n+=len(b)
   if n>maximum:die(f'input too large: {p}')
   chunks.append(b)
 finally:os.close(fd)
 after=os.lstat(p)
 if (before.st_dev,before.st_ino,before.st_size)!=(after.st_dev,after.st_ino,after.st_size):die(f'input raced: {p}')
 return b''.join(chunks)
raw=read_protected(mp,128*1024*1024)
try:m=json.loads(raw)
except Exception:die('manifest is not valid JSON')
required={'schema','commit','tree','commit_object_b64','source_merkle_sha256','files','installer','authority_builder','symlinks','submodules'}
if set(m)!=required or m['schema']!='factory-runner-install-manifest/v2' or m['symlinks']!='reject' or m['submodules']!='reject':die('manifest schema/policy rejected')
if not re.fullmatch(r'[0-9a-f]{40,64}',m['commit']) or not re.fullmatch(r'[0-9a-f]{40,64}',m['tree']):die('bad Git identity')
files=m['files']; closure=hashlib.sha256()
for name,d in sorted(files.items()):
 p=pathlib.PurePosixPath(name)
 if p.is_absolute() or '..' in p.parts or not p.parts or set(d)!={'blob','sha256','mode','size'} or d['mode'] not in (0o644,0o755):die('unsafe manifest member')
 closure.update(name.encode()+b'\0');closure.update(json.dumps(d,sort_keys=True,separators=(',',':')).encode()+b'\0')
if closure.hexdigest()!=m['source_merkle_sha256']:die('source Merkle digest mismatch')
co=base64.b64decode(m['commit_object_b64'],validate=True)
def git_hash(kind,data,nhex):
 framed=kind.encode()+b' '+str(len(data)).encode()+b'\0'+data
 return (hashlib.sha1(framed) if nhex==40 else hashlib.sha256(framed)).hexdigest()
if git_hash('commit',co,len(m['commit']))!=m['commit']:die('commit object mismatch')
if not co.startswith(('tree '+m['tree']+'\n').encode()):die('commit/tree mismatch')
archive_bytes=read_protected(archive,512*1024*1024)
out.mkdir(mode=0o700,parents=True)
seen=set()
import io
with tarfile.open(fileobj=io.BytesIO(archive_bytes),mode='r:*') as tf:
 for member in tf:
  name=member.name.removeprefix('./');
  if member.isdir():continue
  if name not in files or not member.isfile() or member.issym() or member.islnk():die(f'archive member rejected: {name}')
  if name in seen:die(f'duplicate archive member: {name}')
  data=tf.extractfile(member).read();d=files[name]
  if len(data)!=d['size'] or hashlib.sha256(data).hexdigest()!=d['sha256']:die(f'archive digest mismatch: {name}')
  if not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}',str(d['blob'])) or len(d['blob'])!=len(m['tree']) or git_hash('blob',data,len(d['blob']))!=d['blob']:die(f'Git blob mismatch: {name}')
  dest=out/name;dest.parent.mkdir(mode=0o700,parents=True,exist_ok=True)
  fd=os.open(dest,os.O_WRONLY|os.O_CREAT|os.O_EXCL|os.O_CLOEXEC,d['mode'])
  try:os.write(fd,data);os.fsync(fd)
  finally:os.close(fd)
  os.chmod(dest,d['mode']);seen.add(name)
if seen!=set(files):die('archive is not the exact signed tree')
# Reconstruct every nested Git tree from authenticated bytes, exact modes and
# path components. A valid signature over a manifest that merely declares a
# foreign tree must not authorize installation.
trie={}
for name,d in files.items():
 node=trie;parts=pathlib.PurePosixPath(name).parts
 if any(not part or part in ('.','..') for part in parts):die('unsafe Git tree path')
 for part in parts[:-1]:
  if part in node and not isinstance(node[part],dict):die('Git tree file/directory collision')
  node=node.setdefault(part,{})
 if parts[-1] in node:die('duplicate Git tree path')
 node[parts[-1]]=(d['mode'],d['blob'])
def tree_oid(node):
 body=bytearray()
 for name,value in sorted(node.items(),key=lambda x:x[0].encode()+ (b'/' if isinstance(x[1],dict) else b'')):
  if isinstance(value,dict):mode='40000';oid=tree_oid(value)
  else:mode='100755' if value[0]==0o755 else '100644';oid=value[1]
  body.extend(mode.encode()+b' '+name.encode()+b'\0'+bytes.fromhex(oid))
 return git_hash('tree',bytes(body),len(m['tree']))
if tree_oid(trie)!=m['tree']:die('manifest does not reconstruct declared Git tree')
PY
installer="$stage/source/scripts/install-factory-runner-v2.sh"
[ -x "$installer" ] || fail 'signed installer is absent or non-executable'
# Marker proves only that this process followed the independently authenticated
# path.  Installation still revalidates the signed manifest and every byte.
FACTORY_RUNNER_AUTHENTICATED_BOOTSTRAP=1 "$installer" install --source-root "$stage/source" --install-manifest "$manifest" "$@"
