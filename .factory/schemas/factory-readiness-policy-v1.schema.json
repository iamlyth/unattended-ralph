{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-readiness-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "production_authority", "required_runner_classes", "required_capabilities", "conformance_gate_ids", "core_gate_ids", "human_approval", "invalidation"],
  "properties": {
    "schema": {"const": "factory-readiness-policy/v1"},
    "status": {"const": "active"},
    "production_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["enrolled", "reason"],
      "properties": {"enrolled": {"type": "boolean"}, "reason": {"type": "string", "minLength": 1}}
    },
    "required_runner_classes": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "capabilities"], "properties": {"id": {"$ref": "#/$defs/id"}, "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}
    },
    "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "conformance_gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "core_gate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "human_approval": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/human"}]},
    "invalidation": {
      "type": "object", "additionalProperties": false, "required": ["accepted_commit", "current_product", "paths"],
      "properties": {
        "accepted_commit": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "current_product": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "paths": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "human": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "approval_schema", "approval_path", "signature_path", "signature_namespace", "trust_scope", "trust_path", "checklist", "captures"],
      "properties": {
        "required": {"const": true}, "approval_schema": {"$ref": "#/$defs/id"},
        "approval_path": {"type": "string", "minLength": 1}, "signature_path": {"type": "string", "minLength": 1},
        "signature_namespace": {"$ref": "#/$defs/id"}, "trust_scope": {"$ref": "#/$defs/id"},
        "trust_path": {"type": "string", "pattern": "^/"},
        "checklist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "captures": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "path_field", "digest_field"], "properties": {"id": {"$ref": "#/$defs/id"}, "path_field": {"$ref": "#/$defs/id"}, "digest_field": {"$ref": "#/$defs/id"}}}}
      }
    }
  }
}
