{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-plan/v1",
  "title": "factory-plan/v1 parsed plan model",
  "description": "Deterministic JSON model emitted by the stdlib-only parser .factory/loop/plan_parser.py for a canonical factory-plan/v1 plan. The grammar and defect classes are documented in .factory/schemas/factory-plan-v1.schema.md; this file is the machine-readable contract for the parsed model (parser --dump).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "spec_path",
    "spec_commit",
    "spec_blob",
    "base_commit",
    "status",
    "tasks",
    "matrix",
    "interactions"
  ],
  "properties": {
    "schema": {
      "const": "factory-plan/v1"
    },
    "spec_path": {
      "type": "string",
      "minLength": 1,
      "description": "Repository-relative canonical specification path."
    },
    "spec_commit": {
      "$ref": "#/$defs/sha"
    },
    "spec_blob": {
      "$ref": "#/$defs/sha"
    },
    "base_commit": {
      "$ref": "#/$defs/sha"
    },
    "status": {
      "enum": ["active", "complete"],
      "description": "Plan lifecycle status."
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/task" }
    },
    "matrix": {
      "type": "array",
      "items": { "$ref": "#/$defs/matrix_row" }
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction" }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "task_status": {
      "enum": ["pending", "in_progress", "complete", "blocked"]
    },
    "classification": {
      "enum": ["verified", "partial", "missing", "ambiguous", "blocked", "not_applicable"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "status",
        "priority",
        "dependencies",
        "blocked_on",
        "write_scopes",
        "fields"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/task_status"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "blocked_on": {
          "type": ["string", "null"],
          "description": "Exact unresolved reference; non-null for blocked tasks."
        },
        "write_scopes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": "Closed-format `Write scopes:` request list (Phase 2C1). The planner request grants nothing by itself; the trusted policy intersection decides. Empty when the field is absent or `None`."
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "matrix_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "spec_sections",
        "classification",
        "evidence",
        "tasks"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:[-_][A-Z0-9]+)+$"
        },
        "spec_sections": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "text"],
      "properties": {
        "boundary": {
          "enum": ["input boundary", "semantic boundary", "production boundary", "evidence boundary"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
