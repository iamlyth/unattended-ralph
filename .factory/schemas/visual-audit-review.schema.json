{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ralph-visual-audit-review/v1",
  "title": "Structured machine visual-audit review finding",
  "description": "One structured finding produced by a read-only vision reviewer over a provenance-bound captured image. Findings are advisory: they may flag anomalies but never certify runtime and never promote an evidence tier. Every field is machine-validated so hallucinated or malformed output is rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "state_id", "image_sha256", "role", "model", "prompt_sha256",
    "schema_sha256", "request_nonce", "verdict", "observations"
  ],
  "properties": {
    "schema": {
      "const": "ralph-visual-audit-review/v1"
    },
    "state_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "image_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "role": {
      "type": "string",
      "enum": ["diagram", "layout", "legibility", "state", "consistency", "adversarial"]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "prompt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Domain-separated task prompt binding over the exact prompt-template hash, exact expected-state description, and separate calibration classification. This is task-specific, not merely the shared template hash."
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "Fresh 128-bit per-task invocation nonce generated by the orchestrator and echoed verbatim by the reviewer. Proves the invocation is fresh; it never certifies visual truth and never elevates an evidence tier."
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "finding", "error"]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "description"],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "severity": {
            "type": "string",
            "enum": ["info", "low", "medium", "high", "critical"]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "region": {
            "type": "string",
            "maxLength": 512
          },
          "expected": {
            "type": "string",
            "maxLength": 2048
          },
          "observed": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "untrusted_image_text_note": {
      "type": "string",
      "maxLength": 4096
    }
  }
}
