#!/usr/bin/env -S python3 -I
"""Installed standalone launcher with an in-memory package binding."""
import importlib.util
import os
import pathlib
import sys
sys.dont_write_bytecode = True

root = pathlib.Path(__file__).resolve().parents[2]
factory_dir = root / ".factory"
info = os.stat(factory_dir, follow_symlinks=False)
if not factory_dir.is_dir() or info.st_mode & 0o022:
    raise SystemExit("factory-launch: installed closure is mutable or unsafe")
spec = importlib.util.spec_from_file_location(
    "factory", factory_dir / "__init__.py",
    submodule_search_locations=[str(factory_dir)],
)
if spec is None or spec.loader is None:
    raise SystemExit("factory-launch: installed package unavailable")
module = importlib.util.module_from_spec(spec)
sys.modules["factory"] = module
spec.loader.exec_module(module)
from factory.loop.launch import main
raise SystemExit(main())
