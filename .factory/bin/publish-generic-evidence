#!/usr/bin/env bash
# publish-generic-evidence — trusted two-stage generic evidence publisher
# (FACTORY-LOOP-SPEC §19; Task 23).
#
# Runs `.factory/loop/generic_evidence.py` against the canonical repository
# root.  The publisher is deterministic control-plane code: it validates the
# `factory-state/v1` control state and the exact clean HEAD, runs the
# installed harness suite with a sanitized bounded environment, mints the
# installed-harness machine receipt under the allowlisted
# `installed-harness-smoke` category, and publishes the fresh live evidence
# under `.factory-state/generic-evidence/<exact-commit>/` — never touching,
# deleting, or rewriting a pre-existing `.factory-state` file.  No model,
# runner, hardware, or human is invoked.
set -u

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ ! -f "$root/.factory/loop/generic_evidence.py" ]]; then
    echo "publish-generic-evidence: publisher authority is missing: $root" >&2
    exit 1
fi
exec python3 "$root/.factory/loop/generic_evidence.py" --root "$root" "$@"
