# Ralph volatile runtime state (durable recovery scratchpad is tracked)
.ralph/api/
.ralph/current-events
.ralph/current-loop-id
.ralph/diagnostics/
.ralph/events*.jsonl
.ralph/history.jsonl*
.ralph/loop.lock
.ralph/loops.json
.ralph/restart-requested
.ralph/tui-exports/
.ralph/agent/*
!.ralph/agent/scratchpad.md

# Factory runtime state
.factory-state/
.factory-lock
.bug-ledger.lock
.factory/rounds/

# Pi runtime output (agent definitions/settings remain tracked)
.pi/output/
.pi/subagent-schedules/
.pi/agent-memory-local/

# Ollama quota snapshots only. Credentials must never exist in the workspace,
# even as ignored files (enforced by check-workspace-credentials.py).
.ollama-usage-state.json
*.env

# Generic build and generated artifacts
build/
build-*/
target/
dist/
out/
coverage/
*.o
*.a
*.so
*.log

# Python runtime output
__pycache__/
*.py[cod]

# Editor and OS files
.DS_Store
*.swp
*.swo
*~
Testing/
tests/golden-fail/

# Diagnostic and installed-prefix build staging (build artifacts, never commit)
.diag-prefix-build/
.test-diag-inspect/
.install-prefix/
.build-install-diagram/
.test-install-diagram/
.test-install-bin/

# Factory runner SSH keys (never commit)
.factory/ssh/

# Stray study subagent output at repo root (belongs in .factory/artifacts/)
/*SUBSYSTEM*.md
/*subsystem*study*.md

# Per-task audit artifacts (generated during campaign, not source)
.factory/artifacts/audit-*-task*.md
.factory/artifacts/audit-findings-task*.md

# All factory artifacts except the plan are generated during campaigns
.factory/artifacts/*
!.factory/artifacts/implementation-plan.md

# Stray study/audit subagent output in docs/ and src/ (not source documentation)
docs/subsystem-*.md
docs/*-audit-*.md
docs/audit-*.md
docs/*-study-*.md
docs/review-audit-*.md
src/*/SUBSYSTEM-*.md
src/*/subsystem-study-*.md
.factory/patches/
.factory-worktrees/
