#!/usr/bin/env bash
# Fail-closed Git argv boundary for model-invoked commits.
#
# Ralph's tool-call extension rewrites simple direct `git <commit-verb>`
# commands to this shim, and any environment that places the shims directory
# before git on PATH also resolves here. Commit-creating operations are
# enforced before delegation: hook-bypass flags (`--no-verify`, commit `-n`)
# and hooksPath/config redirections are rejected, and the fail-closed
# pre-commit boundary must be installed for the target repository. Content
# enforcement itself remains in scripts/git-commit-guard.sh (the pre-commit
# hook), which fires for every repository commit no matter how git is invoked.
set -euo pipefail

SHIM_SELF=$(readlink -f -- "${BASH_SOURCE[0]}")

resolve_real() {
    local name=$1 dir candidate
    local IFS=:
    for dir in $PATH; do
        dir=${dir:-.}
        candidate="$dir/$name"
        if [[ -x "$candidate" && -f "$candidate" ]]; then
            if [[ "$(readlink -f -- "$candidate")" != "$SHIM_SELF" ]]; then
                printf '%s\n' "$candidate"
                return 0
            fi
        fi
    done
    return 1
}

REAL_GIT=$(resolve_real git) || {
    echo "git-shim: cannot resolve the real Git executable" >&2
    exit 2
}

# Locate the git subcommand, skipping option values (-C <dir>, -c <key>=<val>,
# --config <key>=<val>) so the verb is identified correctly.
verb=
previous=
for argument in "$@"; do
    case "$previous" in
        -C|--git-dir|--work-tree|-c|--config)
            previous=
            continue
            ;;
    esac
    case "$argument" in
        -C|--git-dir|--work-tree|-c|--config)
            previous=$argument
            continue
            ;;
        -C=*|--git-dir=*|--work-tree=*|-c=*|--config=*) continue ;;
        -*) continue ;;
        *)
            verb=$argument
            break
            ;;
    esac
done

COMMIT_VERBS=" commit merge cherry-pick revert am rebase pull "
if [[ -z "$verb" || "$COMMIT_VERBS" != *" $verb "* ]]; then
    exec "$REAL_GIT" "$@"
fi

# Only `git commit` is delegated. Every other commit-creation verb is refused
# at the model's command boundary: cherry-pick and revert run no Git hooks at
# all, am/rebase use patch hooks this boundary does not own, and merge is
# redundant with the harness's checkpoint flow. The fail-closed content policy
# therefore holds for every commit the model can create.
if [[ "$verb" != commit ]]; then
    echo "git-shim: '$verb' can create commits outside the fail-closed boundary; use git commit" >&2
    exit 1
fi

# Hook-bypass attempts are rejected before Git runs. --no-verify and commit -n
# disable every Git hook; -c/--config core.hooksPath and the GIT_CONFIG_* env
# family redirect or suppress hooks. None of these have a legitimate use in the
# Ralph harness (the trusted checkpoint flow never bypasses hooks).
for argument in "$@"; do
    case "$argument" in
        --no-verify)
            echo "git-shim: --no-verify is forbidden: it bypasses the fail-closed commit boundary" >&2
            exit 1
            ;;
        -c=core.hooksPath*|--config=core.hooksPath*|--config-env=core.hooksPath*)
            echo "git-shim: core.hooksPath redirection is forbidden" >&2
            exit 1
            ;;
    esac
done
previous=
for argument in "$@"; do
    case "$previous" in
        -c|--config)
            case "$argument" in
                core.hooksPath|core.hooksPath=*)
                    echo "git-shim: core.hooksPath redirection is forbidden" >&2
                    exit 1
                    ;;
            esac
            previous=
            continue
            ;;
    esac
    case "$argument" in
        -c|--config) previous=$argument ;;
    esac
done
if [[ "$verb" == commit ]]; then
    for argument in "$@"; do
        if [[ "$argument" == -n ]]; then
            echo "git-shim: commit -n (--no-verify) is forbidden: it bypasses the fail-closed commit boundary" >&2
            exit 1
        fi
    done
fi
if [[ -n ${GIT_CONFIG_PARAMETERS:-} || -n ${GIT_CONFIG_COUNT:-} ]] \
    || compgen -v | grep -q '^GIT_CONFIG_KEY_' || compgen -v | grep -q '^GIT_CONFIG_VALUE_'; then
    echo "git-shim: GIT_CONFIG_* hook redirection is forbidden" >&2
    exit 1
fi

# Resolve the target repository the same way git would: keep only -C pairs
# (which select the working tree) and let rev-parse report the git dir.
prefix=()
previous=
for argument in "$@"; do
    case "$previous" in
        -C)
            prefix+=(-C "$argument")
            previous=
            continue
            ;;
    esac
    case "$argument" in
        -C) previous=-C ;;
        -C=*) prefix+=("$argument") ;;
    esac
done

# Fail closed when the target repository has no installed guard or has a
# core.hooksPath redirect in its own configuration. Without the pre-commit
# boundary, a delegated commit could reach history unguarded.
git_dir=$("$REAL_GIT" "${prefix[@]}" rev-parse --absolute-git-dir 2>/dev/null || true)
if [[ -n "$git_dir" ]]; then
    hooks_path=$("$REAL_GIT" "${prefix[@]}" config --get core.hooksPath 2>/dev/null || true)
    if [[ -n "$hooks_path" ]]; then
        echo "git-shim: repository core.hooksPath redirect is forbidden: $hooks_path" >&2
        exit 1
    fi
    # The fail-closed boundary spans every commit-creation path: pre-commit,
    # pre-merge-commit (merge) and commit-msg (merge, cherry-pick, revert, am,
    # rebase). All three must be installed before a commit is delegated.
    for hook_name in pre-commit pre-merge-commit commit-msg; do
        if [[ ! -x "$git_dir/hooks/$hook_name" ]]; then
            echo "git-shim: fail-closed $hook_name boundary is not installed; run ./scripts/install-git-commit-guard.sh" >&2
            exit 1
        fi
    done
fi

exec "$REAL_GIT" "$@"
